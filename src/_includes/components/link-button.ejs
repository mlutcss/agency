<%
	const buttonShape = "-Sz100p D-f Jc-c Ai-c Gap2.5u Fns4u xl_Fns5u Lnh100p Lts0 Fnst-n Fnw400 Bdrd8 -Ts Bd2;s;#EF438B";

    let buttonColors;
	let padding;
	if (it.variant === 'brand') {
		buttonColors = "Bgc-$brand600 Bgc-$brand200_h Bgc-$brand500_a";
		padding = "P4u";
	}
	if (it.variant === 'light') {
		buttonColors = "Bgc-n Bgc-$brand100_h Bgc-$brand600_a";
		padding = "P3u";
	}

	const isLink = it.url && it.url !== '#0';
	const tag = isLink ? 'a' : 'button';
	const className = it.className || '';
	const iconClass = it.iconClass || 'W24 H24';
%>

<<%= tag %>
	class="btn C-$accent900 <%= buttonShape %> <%= buttonColors %> <%= padding %> <%= className %>"
	<%= isLink ? `href=${it.url}` : '' %>
	<%= tag === 'button' ? 'type="button"' : '' %>
>
	<span class="button-text"><%= it.text %></span>
	<% if (it.icon) { %>
		<svg class="button-icon <%= iconClass %>" width="24" height="24">
			<use href="/assets/img/icons.svg#<%= it.icon %>"></use>
		</svg>
	<% } %>
</<%= tag %>>