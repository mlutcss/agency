<%
	const css = {
		buttonShape: '-Sz100p D-f Jc-c Ai-c Gap2.5u Fns4u xl_Fns5u Lnh100p Lts0 Fnst-n Fnw400 Bdrd8 -Ts Bd2;s;#EF438B',
		buttonColors: '',
		padding: ''
	};

	if (it.variant === 'brand') {
		css.buttonColors = "Bgc-$brand600 Bgc-$brand200_h Bgc-$brand500_a";
		css.padding = "P4u";
	} else {
		css.buttonColors = "Bgc-n Bgc-$brand100_h Bgc-$brand600_a";
		css.padding = "P3u";
	}

	const isLink = it.url && it.url !== '#0';
	const tag = it.tag || 'a';
	const className = it.className || '';
	const iconClass = it.iconClass || 'W24 H24';
%>

<<%= tag %>
	class="btn C-$accent900 <%= css.buttonShape %> <%= css.buttonColors %> <%= css.padding %> <%= className %>"
	<%= isLink ? `href=${it.url}` : '' %>
	<%= tag === 'button' ? 'type="button"' : '' %>
>
	<%= it.text %>
	<% if (it.icon) { %>
		<svg class=" <%= iconClass %>" width="24" height="24">
			<use href="/assets/img/icons.svg#<%= it.icon %>"></use>
		</svg>
	<% } %>
</<%= tag %>>